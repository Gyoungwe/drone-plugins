{
	"name": "@gyoungwe/pi-evidence",
	"version": "0.2.0",
	"description": "Portable evidence manifests, provenance, checkpoints and replay proofs for native Pi",
	"keywords": [
		"pi-package",
		"evidence",
		"provenance",
		"reproducibility"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gyoungwe/drone-plugins.git",
		"directory": "packages/pi-evidence"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"src",
		"package.json",
		"README.md",
		"build-manifest.json",
		"plugin.manifest.json"
	],
	"pi": {
		"extensions": [
			"./dist/index.mjs"
		]
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./host": {
			"types": "./src/host.ts",
			"import": "./dist/host.mjs",
			"default": "./dist/host.mjs"
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:check": "node scripts/build.mjs --check",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test test/registration.test.mjs test/contracts.test.mjs test/host.test.mjs test/portable-parity.test.mjs test/portable-disclosure.test.mjs test/portable-import-replay.test.mjs test/portable-limits.test.mjs && vitest run test/failure-diagnostic.test.ts",
		"smoke": "node scripts/smoke.mjs",
		"check": "npm run typecheck && npm run build:check && npm test && npm run smoke"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0 <2.0.0"
	},
	"dependencies": {
		"@gyoungwe/plugin-api": "https://github.com/Gyoungwe/Drone/releases/download/plugin-api-v2.1.0/gyoungwe-plugin-api-2.1.0.tgz"
	},
	"bundleDependencies": [
		"@gyoungwe/plugin-api"
	],
	"devDependencies": {
		"typescript": "^5.9.0",
		"esbuild": "^0.25.12"
	}
}
