{
	"name": "drone-task-ui",
	"version": "0.3.0",
	"displayName": "Tasks",
	"description": "Task journal, Workbench, and Research status. Task views require Plugin API 1.3 session command and message bindings.",
	"droneUi": 1,
	"main": "bundle.js",
	"slots": {
		"chat.message": "TaskMessage"
	},
	"contributions": [
		{
			"id": "tasks",
			"region": "panel.tab",
			"export": "TaskPanel",
			"title": "Tasks"
		},
		{
			"id": "workbench",
			"region": "panel.tab",
			"export": "WorkbenchPanel",
			"title": "Workbench"
		},
		{
			"id": "research-status",
			"region": "panel.tab",
			"export": "ResearchStatusPanel",
			"title": "Research"
		}
	]
}
