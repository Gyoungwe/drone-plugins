{
	"schemaVersion": 1,
	"id": "drone-pi-core",
	"version": "0.3.0",
	"pi": {
		"apiVersion": 1,
		"minHostVersion": "1.1.0",
		"testedHosts": ["1.1.0", "latest"]
	},
	"drone": {
		"pluginApi": 1,
		"resultContract": "drone-result/v3",
		"taskGrants": "request",
		"workspaceRead": "session",
		"requires": {
			"knowledge": {
				"service": "knowledge.binding",
				"version": 1
			}
		},
		"consumes": {
			"acceptance": {
				"servicePrefix": "task.acceptance:",
				"version": 1
			}
		}
	},
	"entrypoints": {
		"extension": "./dist/index.mjs",
		"desktopRuntime": "./dist/managed-runtime.mjs",
		"host": "./dist/host.mjs",
		"ui": "./ui/plugin.json"
	},
	"capabilities": ["core", "planning", "tasks", "files", "read-only", "evidence", "evidence-context", "ui"],
	"tools": [
		"ask_user",
		"set_status",
		"todo",
		"deliver_files",
		"memory_save",
		"task_status",
		"task_plan",
		"task_wait",
		"task_reconcile",
		"task_evidence_restore",
		"workbench_plan",
		"workbench_status",
		"workbench_todo",
		"workbench_memory_save"
	],
	"hosts": ["native-pi", "drone-desktop"],
	"permissions": {
		"filesystem": ["workspace-read", "workspace"],
		"network": [],
		"subprocess": [],
		"externalWrites": false
	}
}
