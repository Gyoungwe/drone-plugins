{
	"name": "@gyoungwe/pi-discovery",
	"version": "0.2.0",
	"description": "Host-injected discovery algorithms and journals for Drone",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"keywords": [
		"pi-package",
		"discovery"
	],
	"pi": {
		"extensions": [
			"./dist/index.mjs"
		]
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./host": {
			"types": "./src/host.ts",
			"import": "./dist/host.mjs",
			"default": "./dist/host.mjs"
		},
		"./native": {
			"types": "./src/native-runtime.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"package.json",
		"README.md",
		"build-manifest.json",
		"plugin.manifest.json",
		"ui"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:check": "node scripts/build.mjs --check",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test test/host.test.mjs test/native.test.mjs test/lifecycle.test.mjs",
		"test:sdk": "node scripts/check-sdk-sessions.mjs",
		"smoke": "node scripts/smoke.mjs",
		"check": "npm run typecheck && npm run build:check && npm test && npm run smoke"
	},
	"dependencies": {},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0 <2.0.0",
		"@gyoungwe/plugin-api": "^1.3.0"
	},
	"devDependencies": {
		"@types/node": "^22.19.19",
		"esbuild": "^0.25.12",
		"typescript": "^5.9.0"
	}
}
