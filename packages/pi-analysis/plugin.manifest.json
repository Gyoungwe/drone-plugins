{
	"schemaVersion": 1,
	"id": "drone-pi-analysis",
	"version": "0.1.2",
	"pi": {
		"apiVersion": 1,
		"minHostVersion": "1.1.0",
		"testedHosts": ["1.1.0", "latest"]
	},
	"drone": {
		"pluginApi": 1,
		"resultContract": "drone-result/v3"
	},
	"entrypoints": {
		"extension": "./dist/index.mjs",
		"host": "./dist/host.mjs"
	},
	"capabilities": ["analysis", "planning", "files"],
	"tools": ["analysis_list_adapters", "analysis_assess_readiness"],
	"hosts": ["native-pi", "drone-desktop"],
	"permissions": {
		"filesystem": ["workspace-read"],
		"network": [],
		"subprocess": [],
		"externalWrites": false
	}
}
