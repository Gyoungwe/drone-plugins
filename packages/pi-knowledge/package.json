{
	"name": "@gyoungwe/pi-knowledge",
	"version": "0.1.1",
	"description": "Knowledge and Vault tools for native Pi hosts",
	"repository": {
		"type": "git",
		"url": "https://github.com/Gyoungwe/drone-plugins.git",
		"directory": "packages/pi-knowledge"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.mjs",
	"files": [
		"dist",
		"lib",
		"skills",
		"plugin.manifest.json",
		"package.json",
		"README.md",
		"build-manifest.json"
	],
	"pi": {
		"extensions": [
			"./dist/index.mjs"
		],
		"skills": [
			"./skills/*"
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:check": "node scripts/build.mjs --check",
		"smoke": "node scripts/smoke.mjs",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0 <2.0.0"
	},
	"devDependencies": {
		"typescript": "^5.9.0"
	}
}
