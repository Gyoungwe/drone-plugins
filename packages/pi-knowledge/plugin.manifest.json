{
	"schemaVersion": 1,
	"id": "drone-pi-knowledge",
	"version": "0.3.1",
	"pi": {
		"apiVersion": 1,
		"minHostVersion": "1.1.0",
		"testedHosts": ["1.1.0", "latest"]
	},
	"drone": {
		"pluginApi": 1,
		"resultContract": "drone-result/v3",
		"credentials": [
			{
				"slot": "webdav",
				"label": { "zh": "WebDAV 云端知识库密码", "en": "WebDAV cloud knowledge password" },
				"hosts": ["10.126.126.1:8080"],
				"header": "Authorization",
				"fields": [],
				"authentication": "http-basic-digest",
				"custody": "host-environment"
			}
		],
		"deliveryProjection": "required",
		"networkPolicy": {
			"runtimeEndpoint": {
				"allowed": true,
				"credentialSlot": "webdav"
			}
		},
		"nativeChildSessions": "read-only",
		"requires": {
			"tasks": {
				"service": "task.runtime",
				"version": 1
			}
		},
		"provides": {
			"knowledge.binding": {
				"version": 1,
				"operations": ["binding"]
			},
			"knowledge.failure-candidates": {
				"version": 1,
				"operations": ["recordFailureCandidate", "queryFailureCandidates"]
			}
		},
		"recordAdoptions": {
			"drone-knowledge-recovery-v1": {
				"legacyType": "drone-knowledge-recovery-v1",
				"fromVersions": ["0.2.0", "0.2.1"],
				"removeBeforeVersion": "0.4.0"
			}
		}
	},
	"entrypoints": {
		"extension": "./dist/index.mjs",
		"worker": "./lib/knowledge/runtime/worker.mjs",
		"host": "./dist/host.mjs",
		"skills": "./skills",
		"ui": "./ui/plugin.json",
		"desktopRuntime": "./dist/desktop-runtime.mjs",
		"resources": {
			"index": "./lib/knowledge/runtime/desktop-index.mjs"
		}
	},
	"capabilities": ["knowledge", "search", "evidence-context", "ui"],
	"tools": [
		"knowledge_status",
		"knowledge_search",
		"research_prepare_knowledge",
		"research_topics",
		"research_resume_topic",
		"research_read_knowledge",
		"research_restore_evidence",
		"research_search_knowledge",
		"research_check_answer",
		"research_task_status",
		"research_search_explainers",
		"research_knowledge_status",
		"research_update_topic",
		"research_archive_topic",
		"research_maintain_knowledge",
		"research_delegate_knowledge",
		"research_archive_explainer",
		"research_propose_wiki_update",
		"research_wiki_review_status"
	],
	"hosts": ["native-pi", "drone-desktop"],
	"permissions": {
		"filesystem": [
			"workspace",
			"configured-vault",
			"configured-vault-write",
			"application-state",
			"application-state-write"
		],
		"network": ["configured-services", "10.126.126.1:8080"],
		"credentials": ["host-kept WebDAV password (drone.credentials)"],
		"subprocess": [],
		"externalWrites": true,
		"readWrite": {
			"read": true,
			"write": true,
			"delete": true
		}
	}
}
