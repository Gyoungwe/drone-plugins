{
	"schemaVersion": 1,
	"id": "drone-pi-research",
	"version": "0.4.0",
	"pi": {
		"apiVersion": 1,
		"minHostVersion": "1.1.0",
		"testedHosts": ["1.1.0", "latest"]
	},
	"drone": {
		"pluginApi": 1,
		"resultContract": "drone-result/v3",
		"networkReads": ["127.0.0.1:23119/connector/ping", "127.0.0.1:23119/connector/getSelectedCollection"],
		"credentials": [
			{
				"slot": "zotero-web",
				"label": { "zh": "Zotero 网页 API 密钥", "en": "Zotero Web API key" },
				"hosts": ["api.zotero.org"],
				"header": "Zotero-API-Key",
				"fields": ["libraryType", "libraryId"]
			},
			{
				"slot": "zotero-local",
				"label": { "zh": "Zotero 本机写入", "en": "Zotero local writes" },
				"hosts": ["127.0.0.1:23119"],
				"header": "Zotero-API-Key",
				"fields": ["serverId"],
				"custody": "host-environment"
			}
		],
		"provides": {
			"task.acceptance:zotero_item": {
				"version": 1,
				"operations": ["describe", "verify", "identify"]
			}
		},
		"requires": {
			"knowledgeFailures": { "service": "knowledge.failure-candidates", "version": 1 }
		}
	},
	"entrypoints": {
		"extension": "./dist/index.mjs",
		"skills": "./skills",
		"host": "./dist/host.mjs",
		"desktopRuntime": "./dist/desktop-runtime.mjs",
		"ui": "./ui/plugin.json"
	},
	"capabilities": [
		"research",
		"search",
		"evidence-context",
		"files",
		"ui",
		"connectors",
		"provenance-receipts"
	],
	"tools": [
		"research_search_sources",
		"research_read_source",
		"research_deposit_research_note",
		"research_answer_sources",
		"research_status",
		"research_loop",
		"connector_list",
		"connector_get"
	],
	"hosts": ["native-pi", "drone-desktop"],
	"permissions": {
		"filesystem": ["workspace", "configured-vault"],
		"network": [
			"api.zotero.org",
			"127.0.0.1:23119",
			"www.ebi.ac.uk",
			"europepmc.org",
			"pmc-oa-opendata.s3.amazonaws.com",
			"api.unpaywall.org",
			"api.openalex.org",
			"api.semanticscholar.org",
			"api.crossref.org",
			"arxiv.org",
			"doi.org",
			"astral.sh",
			"pypi.org",
			"files.pythonhosted.org",
			"host-authorized source and institutional endpoints"
		],
		"subprocess": ["uv", "uvx", "zotero-mcp", "sh", "curl", "powershell", "where.exe"],
		"externalWrites": true,
		"credentials": [
			"host-kept Zotero Web API key (drone.credentials)",
			"host-supplied Zotero environment or local API reference"
		],
		"externalSideEffects": [
			"host-authorized Zotero item and attachment writes",
			"host-authorized Zotero MCP and uv installation"
		]
	},
	"connectorDeclarations": [
		{
			"id": "zotero",
			"readOnly": true,
			"network": "public:api.zotero.org",
			"credentials": "optional host-secret-store/environment",
			"externalSideEffects": []
		},
		{
			"id": "webdav",
			"readOnly": true,
			"network": "configured endpoint",
			"credentials": "required host-secret-store/environment",
			"externalSideEffects": []
		},
		{
			"id": "generic-mcp",
			"readOnly": true,
			"network": "host-configured endpoint",
			"credentials": "optional mcp-config/host-secret-store",
			"externalSideEffects": []
		},
		{
			"id": "institutional",
			"readOnly": true,
			"network": "configured institutional host",
			"credentials": "required browser-session/oauth",
			"externalSideEffects": ["browser-navigation"]
		},
		{
			"id": "search",
			"readOnly": true,
			"network": "declared public provider",
			"credentials": "none",
			"externalSideEffects": []
		},
		{
			"id": "arxiv",
			"readOnly": true,
			"network": "public:export.arxiv.org, arxiv.org",
			"credentials": "none",
			"externalSideEffects": []
		},
		{
			"id": "semantic-scholar",
			"readOnly": true,
			"network": "public:api.semanticscholar.org",
			"credentials": "none",
			"externalSideEffects": []
		},
		{
			"id": "browser",
			"readOnly": true,
			"network": "host-approved navigation target",
			"credentials": "optional browser-session",
			"externalSideEffects": ["browser-navigation"]
		}
	]
}
