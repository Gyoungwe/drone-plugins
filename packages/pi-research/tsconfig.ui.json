{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom", "vitest/globals"]
  },
  "include": ["ui/**/*.ts", "ui/**/*.tsx"],
  "exclude": ["ui/**/*.test.ts", "ui/**/*.test.tsx"]
}
