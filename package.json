{
  "name": "@drone/plugins-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Drone capability and Desktop UI plugins",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "check:manifests": "node scripts/check-manifests.mjs",
    "check:pi-knowledge": "npm run --workspace @gyoungwe/pi-knowledge build:check",
    "smoke:pi-knowledge": "npm run --workspace @gyoungwe/pi-knowledge smoke",
    "smoke:install": "node scripts/smoke-install.mjs",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --workspaces --dry-run",
    "check": "npm run check:manifests && npm run typecheck && npm run check:pi-knowledge && npm run smoke:install && npm run pack:check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
